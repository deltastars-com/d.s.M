# LOGGING
LOG_LEVEL=info
LOG_FILE=/var/log/deltastars/app.log
DEBUG_MODE=false

# DATABASE
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# ============================================================================
# 🔒 SECURITY NOTES
