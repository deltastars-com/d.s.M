# ═══════════════════════════════════════════════════════════════
#  Delta Stars | نجوم دلتا — قالب متغيرات البيئة
#  انسخ هذا الملف باسم .env واملأ القيم الحقيقية
#  ⛔ لا تضع أي مفتاح حقيقي هنا — هذا الملف يُرفع للمستودع
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ───
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Google Services ───
VITE_GEMINI_KEY=YOUR_GEMINI_API_KEY
VITE_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY

# ─── Firebase ───
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY

# ─── بوابة ميسر ───
VITE_MOYASAR_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXX

# ─── التطبيق ───
VITE_APP_NAME=Delta Stars
VITE_APP_URL=https://deltastars.store
VITE_API_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPPORT_EMAIL=info@deltastars-ksa.com
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=YOUR_PAGE_ID

# ═══ خادوم فقط (Netlify Functions) — لا تبدأ بـ VITE_ ═══
MOYASAR_SECRET_KEY=sk_live_XXXXXXXXXXXX
AUTHENTICA_API_KEY=YOUR_AUTHENTICA_KEY
AUTHENTICA_API_SECRET=YOUR_AUTHENTICA_SECRET
GEMINI_SERVER_KEY=YOUR_GEMINI_SERVER_KEY
