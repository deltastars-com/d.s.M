<body>
  <div id="ds-splash" role="status" aria-live="polite" aria-label="جارٍ تحميل المتجر">
    <div class="ds-logo-wrap">
      <img class="ds-logo-img" src="/splash-logo.png" alt="DeltaStars نجوم دلتا" decoding="async" fetchpriority="high" />
    </div>
    <div class="ds-brand">نجوم دلتا</div>
    <div class="ds-tagline">DELTASTARS</div>
    <div class="ds-loader" role="progressbar" aria-label="نسبة التحميل"></div>
    <div class="ds-loading-text">جارٍ تحميل المتجر…</div>
    <div class="ds-copyright">© 2026 DeltaStars — جميع الحقوق محفوظة</div>
  </div>

  <noscript>
    <div class="ds-noscript">
      <h2>يتطلب المتجر تفعيل JavaScript</h2>
      <p>الرجاء تفعيل JavaScript في متصفحك لعرض متجر نجوم دلتا.</p>
    </div>
  </noscript>

  <div id="root"></div>

  <script>
  (function () {
    var splash = document.getElementById('ds-splash');
    var root = document.getElementById('root');
    var ready = false;
    var MIN_SHOW = 550;
    var HARD_CAP = 11000;
    var t0 = Date.now();

    function hide() {
      if (!splash) return;
      var wait = Math.max(0, MIN_SHOW - (Date.now() - t0));
      setTimeout(function () {
        splash.classList.add('ds-hide');
        setTimeout(function () {
          if (splash && splash.parentNode) splash.parentNode.removeChild(splash);
          document.documentElement.setAttribute('data-app-ready', '1');
        }, 620);
      }, wait);
    }

    window.__dsAppReady = function () { if (!ready) { ready = true; hide(); } };

    if (root && 'MutationObserver' in window) {
      var mo = new MutationObserver(function () {
        if (root.children.length && root.textContent.trim().length) {
          mo.disconnect();
          if (!ready) { ready = true; hide(); }
        }
      });
      mo.observe(root, { childList: true, subtree: true });
    }

    setTimeout(function () { if (!ready) { ready = true; hide(); } }, HARD_CAP);

    window.addEventListener('error', function (e) {
      var f = (e.filename || '');
      var m = (e.message || '').toLowerCase();
      var chunkFail = f.indexOf('/assets/') > -1 ||
                      m.indexOf('chunk') > -1 ||
                      m.indexOf('failed to fetch dynamically imported') > -1;
      if (chunkFail && !sessionStorage.getItem('ds_recovered')) {
        sessionStorage.setItem('ds_recovered', '1');
        var jobs = [];
        if ('serviceWorker' in navigator) {
          jobs.push(navigator.serviceWorker.getRegistrations().then(function (rs) {
            return Promise.all(rs.map(function (r) { return r.unregister(); }));
          }).catch(function () {}));
        }
        if ('caches' in window) {
          jobs.push(caches.keys().then(function (ks) {
            return Promise.all(ks.map(function (k) { return caches.delete(k); }));
          }).catch(function () {}));
        }
        Promise.all(jobs).then(function () { setTimeout(function () { location.reload(); }, 350); });
      }
    }, true);

    window.addEventListener('error', function (e) {
      var m = (e.message || '').toLowerCase();
      var s = (e.filename || '').toLowerCase();
      if (m.indexOf('websocket') > -1 || m.indexOf('vite') > -1 ||
          s.indexOf('@vite/client') > -1 || s.indexOf('rum') > -1) {
        e.preventDefault(); e.stopPropagation();
      }
    });
    window.addEventListener('unhandledrejection', function (e) {
      var r = String(e.reason || '');
      if (r.indexOf('WebSocket') > -1 || r.indexOf('vite') > -1 ||
          r.indexOf('AbortError') > -1 || r.indexOf('rum_collection') > -1) {
        e.preventDefault();
      }
    });

    if ('serviceWorker' in navigator && location.protocol === 'https:') {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/service-worker.js').catch(function () {});
      });
    }
  })();
  </script>

