  <style>
    :root { --ds-primary:#2d5a27; --ds-secondary:#ca8a04; --ds-dark:#0b1d0b; --ds-gold:#f4b942; }
    *,*::before,*::after { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
    html { -webkit-text-size-adjust:100%; }
    html,body {
      margin:0; padding:0; width:100%; min-height:100%;
      background:var(--ds-dark);
      font-family:'Tajawal',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
      overflow-x:hidden;
      -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    }
    #root { min-height:100vh; min-height:100dvh; }

    #ds-splash {
      position:fixed; inset:0; z-index:2147483647;
      background:
        radial-gradient(circle at 50% 38%, rgba(45,90,39,.55) 0%, transparent 62%),
        linear-gradient(165deg,#12331a 0%,#0b1d0b 55%,#040c04 100%);
      display:flex; align-items:center; justify-content:center; flex-direction:column;
      transition:opacity .55s cubic-bezier(.4,0,.2,1), visibility .55s;
      padding:calc(24px + env(safe-area-inset-top)) 24px calc(24px + env(safe-area-inset-bottom));
    }
    #ds-splash.ds-hide { opacity:0; visibility:hidden; pointer-events:none; }

    .ds-logo-wrap {
      width:clamp(140px,46vw,240px); height:clamp(140px,46vw,240px);
      display:flex; align-items:center; justify-content:center;
      position:relative; animation:dsFloat 3.4s ease-in-out infinite;
    }
    .ds-logo-wrap::before {
      content:''; position:absolute; inset:-18%;
      background:radial-gradient(circle, rgba(244,185,66,.30), transparent 66%);
      border-radius:50%; animation:dsGlow 2.4s ease-in-out infinite; pointer-events:none;
    }
    .ds-logo-img {
      width:100%; height:100%;
      object-fit:contain;
      filter:drop-shadow(0 10px 34px rgba(244,185,66,.45));
      position:relative; z-index:2;
    }
    @keyframes dsFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-9px)} }
    @keyframes dsGlow { 0%,100%{opacity:.32;transform:scale(1)} 50%{opacity:.8;transform:scale(1.14)} }

    .ds-brand {
      margin-top:clamp(20px,4vh,34px);
      font-size:clamp(26px,7vw,38px); font-weight:900;
      background:linear-gradient(90deg,#ca8a04,#f4b942,#ca8a04);
      background-size:200% 100%;
      -webkit-background-clip:text; background-clip:text;
      -webkit-text-fill-color:transparent;
      animation:dsShimmer 3s linear infinite;
      letter-spacing:.5px; text-align:center; line-height:1.25;
    }
    @keyframes dsShimmer { 0%{background-position:0% 50%} 100%{background-position:200% 50%} }

    .ds-tagline {
      color:rgba(255,255,255,.62);
      font-size:clamp(11px,3vw,14px); margin-top:6px;
      letter-spacing:4px; font-weight:600; text-align:center;
    }
    .ds-loader {
      margin-top:clamp(26px,5vh,42px);
      width:clamp(160px,55vw,230px); height:3px;
      background:rgba(255,255,255,.08); border-radius:99px;
      overflow:hidden; position:relative;
    }
    .ds-loader::before {
      content:''; position:absolute; top:0; left:-100%;
      width:100%; height:100%;
      background:linear-gradient(90deg,transparent,var(--ds-gold),transparent);
      animation:dsSlide 1.35s ease-in-out infinite;
    }
    @keyframes dsSlide { 0%{left:-100%} 100%{left:100%} }
    .ds-loading-text {
      color:rgba(255,255,255,.42);
      font-size:clamp(11px,2.8vw,13px); margin-top:16px;
      animation:dsBlink 1.6s ease-in-out infinite; text-align:center;
    }
    @keyframes dsBlink { 0%,100%{opacity:.42} 50%{opacity:.9} }
    .ds-copyright {
      position:absolute; bottom:calc(16px + env(safe-area-inset-bottom));
      color:rgba(255,255,255,.22); font-size:10.5px;
      letter-spacing:.6px; text-align:center; width:100%;
    }
    .ds-noscript {
      color:#fff; text-align:center; padding:36px 22px;
      background:rgba(255,255,255,.05); border-radius:20px;
      max-width:400px; margin:20px auto;
    }
    @media (prefers-reduced-motion:reduce) {
      .ds-logo-wrap,.ds-logo-wrap::before,.ds-brand,.ds-loader::before,.ds-loading-text { animation:none !important; }
    }
