{
  "name": "delta-stars",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "build:netlify": "vite build",
    "build:vercel": "vite build",
    "preview": "vite preview --port 4173 --host",
    "start": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sync": "npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "bun run build && npx cap sync android",
    "build:ios": "bun run build && npx cap sync ios",
    "build:apk": "bun run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:aab": "bun run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "deploy:netlify": "bun run build && netlify deploy --prod --dir=dist",
    "deploy:vercel": "bun run build && vercel --prod",
    "version:patch": "node scripts/update-version.js --patch",
    "version:minor": "node scripts/update-version.js --minor",
    "version:major": "node scripts/update-version.js --major",
    "version:show": "node -p \"require('./package.json').version\"",
    "audit:security": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --legacy-peer-deps",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u --target minor && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.1.5",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.96.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vis.gl/react-google-maps": "^1.9.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.6.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.8",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "postcss": "^8.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.6",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.9.2",
    "supabase": "^2.100.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "terser": "^5.47.1",
    "typescript": "5.8.2",
    "vite": "6.2.0",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@reduxjs/toolkit": "^2.2.8",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.3",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "description": "Delta Stars — متجر نجوم دلتا | Owner: Ali Aldahan",
  "author": "Ali Aldahan <info@deltastars-ksa.com>",
